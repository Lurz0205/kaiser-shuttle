; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Anime Badminton: Boom Smash"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps.web=60

[audio]

general/output_latency.web=50

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/initial_position_type=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode.web=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/max_physics_steps_per_frame=2
common/max_physics_steps_per_frame.web=8
common/physics_ticks_per_second.web=60
common/physics_interpolation=true
common/physics_interpolation.web=false

[rendering]

renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=2
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_2d.web=0
anti_aliasing/quality/use_debanding=true
anti_aliasing/quality/use_debanding.web=false
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/screen_space_aa.web=0
environment/defaults/default_environment="res://scenes/default_env.tres"
